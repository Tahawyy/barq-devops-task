# ---- Public ----
# Host port NGINX listens on (8090 for video)
PUBLIC_PORT=8090

# ---- Postgres ----
POSTGRES_USER=barq_app
POSTGRES_DB=barq_tasks
POSTGRES_PASSWORD=change-me-in-real-deployments

# ---- App ----
# Identity and message (INSTANCE_ID is set per-service in docker-compose.yml)
APP_MESSAGE=Welcome to BARQ Systems
APP_HOST=0.0.0.0
APP_PORT=8080

# ---- Dependencies ----
# These are the connections the app uses; use backend network service names
DATABASE_URL=postgresql://barq_app:change-me@postgres:5432/barq_tasks
REDIS_URL=redis://redis:6379/0